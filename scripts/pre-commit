#!/bin/bash
# Pre-commit hook for Internet Archive Apple TV
# Runs SwiftLint on staged Swift files before commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running SwiftLint pre-commit check..."

# Check if SwiftLint is installed
if ! command -v swiftlint &> /dev/null; then
    echo -e "${RED}❌ SwiftLint is not installed.${NC}"
    echo "Install it with: brew install swiftlint"
    echo "Or add it to your Podfile: pod 'SwiftLint'"
    exit 1
fi

# Get null-delimited list of staged Swift files (handles spaces in paths)
STAGED_SWIFT_FILES=$(git diff --cached --name-only -z --diff-filter=ACM | tr '\0' '\n' | grep '\.swift$' || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
    echo -e "${GREEN}✅ No Swift files to lint${NC}"
    exit 0
fi

echo "Checking files:"
echo "$STAGED_SWIFT_FILES" | while IFS= read -r file; do
    echo "  - $file"
done

# Run SwiftLint on staged files using null-delimited xargs for safe path handling
echo ""

LINT_EXIT_CODE=0
git diff --cached --name-only -z --diff-filter=ACM | grep -z '\.swift$' | xargs -0 swiftlint lint --config .swiftlint.yml --quiet || LINT_EXIT_CODE=$?

if [ $LINT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo -e "${YELLOW}⚠️  SwiftLint found issues in staged files.${NC}"
    echo ""
    echo "To see all issues, run:"
    echo "  swiftlint lint"
    echo ""
    echo "To auto-fix some issues, run:"
    echo "  swiftlint --fix"
    echo ""
    echo "To bypass this check (not recommended), use:"
    echo "  git commit --no-verify"
    echo ""

    echo -e "${RED}Commit blocked due to SwiftLint violations.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ SwiftLint check passed!${NC}"
exit 0
