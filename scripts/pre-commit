#!/bin/bash
# Pre-commit hook for Internet Archive Apple TV
# Runs SwiftLint on staged Swift files before commit

set -e

# Git runs hooks from the top of the working tree already (githooks(5));
# this cd makes the script equally safe to run manually from anywhere.
cd "$(git rev-parse --show-toplevel)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Running SwiftLint pre-commit check..."

# Check if SwiftLint is installed
if ! command -v swiftlint &> /dev/null; then
    echo -e "${RED}❌ SwiftLint is not installed.${NC}"
    echo "Install it with: brew install swiftlint"
    exit 1
fi

# Collect staged Swift files once into a temp file (null-delimited for safe path handling)
FILELIST=$(mktemp)
trap 'rm -f "$FILELIST"' EXIT
git diff --cached --name-only -z --diff-filter=ACM -- '*.swift' > "$FILELIST"

if [ ! -s "$FILELIST" ]; then
    echo -e "${GREEN}✅ No Swift files to lint${NC}"
    exit 0
fi

echo "Checking files:"
xargs -0 -n1 printf '  - %s\n' < "$FILELIST"

# Run SwiftLint on the same file list
echo ""

LINT_EXIT_CODE=0
xargs -0 swiftlint lint --config .swiftlint.yml --quiet < "$FILELIST" || LINT_EXIT_CODE=$?

if [ $LINT_EXIT_CODE -ne 0 ]; then
    echo ""
    echo -e "${YELLOW}⚠️  SwiftLint found issues in staged files.${NC}"
    echo ""
    echo "To see all issues, run:"
    echo "  swiftlint lint"
    echo ""
    echo "To auto-fix some issues, run:"
    echo "  swiftlint --fix"
    echo ""
    echo "To bypass this check (not recommended), use:"
    echo "  git commit --no-verify"
    echo ""

    echo -e "${RED}Commit blocked due to SwiftLint violations.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ SwiftLint check passed!${NC}"

# Duplicate-code ratchet (jscpd) - the threshold lives in .jscpd.json and
# should only ever be lowered. Clones pair files, so scan the whole
# production tree (~0.1s) rather than just the staged files.
echo ""
echo "🔍 Running jscpd duplicate-code check..."
if ! command -v jscpd &> /dev/null; then
    echo -e "${YELLOW}⚠️  jscpd not installed (npm install -g jscpd) - skipping; CI enforces this check${NC}"
else
    DUP_EXIT=0
    jscpd --silent "Internet Archive" || DUP_EXIT=$?
    if [ $DUP_EXIT -ne 0 ]; then
        echo ""
        echo -e "${RED}Commit blocked: duplicated code exceeds the threshold in .jscpd.json.${NC}"
        echo "To see the duplicated blocks, run:"
        echo "  jscpd --reporters consoleFull \"Internet Archive\""
        echo ""
        echo "To bypass this check (not recommended), use:"
        echo "  git commit --no-verify"
        exit 1
    fi
    echo -e "${GREEN}✅ Duplicate-code check passed${NC}"
fi

exit 0
